<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <PackageId>CC.CircularSlider.MAUI</PackageId>
        <Version>1.1.0</Version>
        <Authors>Code Chemistry</Authors>
        <Company>Code Chemistry</Company>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>CC.CircularSlider.MAUI Circular slider implementation for .NET MAUI</Description>
        <PackageTags>circular;slider;arc;dotnet-maui;dotnet;maui;touch;ios;android;cross-platform</PackageTags>
        <RepositoryUrl>https://github.com/codechem/CC.CircularSlider</RepositoryUrl>
        <PackageProjectUrl>https://github.com/codechem/CC.CircularSlider</PackageProjectUrl>
        <PackageReleaseNotes>Retargeted to .NET 10 MAUI and updated SkiaSharp to 3.119.4 to support current Android toolchains and 16 KB page-size readiness.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LICENSE.md" Pack="true" PackagePath=""/>
        <None Include="../../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70"/>
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4"/>
    </ItemGroup>
    
</Project>
